# OpenAI-compatible API credentials. Copy this file to .env and fill in real values.
# Do not commit .env.

# API key (DeepSeek: https://platform.deepseek.com/api_keys)
OPENAI_API_KEY=

# Endpoint. DeepSeek official API:
OPENAI_BASE_URL=https://api.deepseek.com

# Model used by the reproduction pipeline.
# DeepSeek currently serves: deepseek-flash (V4.1-Flash), deepseek-v4-pro.
# The 2025-era names deepseek-chat / deepseek-reasoner were retired on 2026-07-24.
MRBALANCE_MODEL=deepseek-flash

# Reasoning effort: none | low | high | max.
# DeepSeek V4 enables thinking by default (high). "none" disables it, matching the
# paper's non-reasoning baseline (gpt-4o-mini) and keeping token costs low.
# Improvement experiments can switch to low/high for comparison.
MRBALANCE_REASONING_EFFORT=none
