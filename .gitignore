# Third-party reference implementation (GPL-3.0), never vendor it
reference/
# Worktrees may symlink the reference checkout; a symlink is not a directory,
# so the trailing-slash rule above does not cover it.
reference

# Generated experiment artifacts
outputs/
logs/

# paper_report is a standalone git repo (embedded). Exclude it entirely;
# manage its history inside paper_report/ itself.
paper_report/

